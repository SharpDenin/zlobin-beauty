# Copy to .env for local overrides. Do not commit real secrets.
JWT_SECRET=dev-change-me-in-production-32chars
INTERNAL_TOKEN=dev-internal-token
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin1!
BOOTSTRAP_ADMIN_NAME=System Admin
# Host-published API gateway port (compose maps 8090→8080; 8080 is often taken).
VITE_API_BASE_URL=http://localhost:8090
# Demo seed (docker compose --profile seed / scripts/seed.ps1 / go run ./cmd/seed)
SEED_PASSWORD=Password123!
