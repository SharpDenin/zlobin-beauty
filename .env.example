# Copy to .env for local/server overrides. Do not commit real secrets.
JWT_SECRET=dev-change-me-in-production-32chars
INTERNAL_TOKEN=dev-internal-token
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin1!
BOOTSTRAP_ADMIN_NAME=System Admin
SEED_PASSWORD=Password123!

# Public URLs (browser). On a server set real hostnames, not localhost.
VITE_API_BASE_URL=http://localhost:8090
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_ENV=development
ALLOW_DEV_BILLING=true

# Media
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
UPLOAD_MAX_BYTES=52428800

# Map / routing (haversine is default recommended-route, not a mathematical optimum)
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=

# Optional published ports
# GATEWAY_PORT=8090
# FRONTEND_PORT=5173
# POSTGRES_PORT=5433
