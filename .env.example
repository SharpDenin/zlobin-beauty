# Local development template. For a server use `.env.production.example`.
# Do not commit real secrets.

# REQUIRED for any non-local demo / production-like deploy:
# Generate strong values, e.g. `openssl rand -hex 32`
JWT_SECRET=REPLACE_ME_WITH_LONG_RANDOM_SECRET_32CHARS_MIN
INTERNAL_TOKEN=REPLACE_ME_WITH_LONG_RANDOM_INTERNAL_TOKEN

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin1!
BOOTSTRAP_ADMIN_NAME=System Admin
SEED_PASSWORD=Password123!

# Public URLs seen by the BROWSER (baked into frontend image via VITE_*).
# On a server these MUST NOT be localhost — use public hostnames/IPs.
VITE_API_BASE_URL=http://localhost:8090
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_ENV=development
ALLOW_DEV_BILLING=true

# Media / MinIO — change for production
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
POSTGRES_PASSWORD=postgres
UPLOAD_MAX_BYTES=52428800

# Map / routing (haversine is default recommended-route, not a mathematical optimum)
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=

# Optional published ports
# GATEWAY_PORT=8090
# FRONTEND_PORT=5173
# POSTGRES_PORT=5433
