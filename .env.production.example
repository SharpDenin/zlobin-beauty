# Copy to .env on the server and replace every REPLACE_ME value.
# Never commit the resulting .env.
APP_ENV=production
ALLOW_DEV_BILLING=false

JWT_SECRET=REPLACE_ME_RANDOM_64_HEX
INTERNAL_TOKEN=REPLACE_ME_DIFFERENT_RANDOM_64_HEX
POSTGRES_PASSWORD=REPLACE_ME_RANDOM_POSTGRES_PASSWORD
MINIO_ROOT_USER=REPLACE_ME_MINIO_USER
MINIO_ROOT_PASSWORD=REPLACE_ME_RANDOM_MINIO_PASSWORD
INTERNAL_BIND_HOST=127.0.0.1

VITE_API_BASE_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Only needed when a server demo is intentionally seeded.
# Never set ALLOW_SEED=true on real production.
ALLOW_SEED=false
SEED_PASSWORD=REPLACE_ME_DEMO_PASSWORD
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_RANDOM_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_NAME=System Admin

UPLOAD_MAX_BYTES=52428800
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=
