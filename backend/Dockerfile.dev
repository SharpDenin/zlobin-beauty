# Local/dev-only backend image. Production uses ./Dockerfile (Alpine).
# Debian avoids Alpine apk/HTTPS index failures on some Docker Desktop hosts
# ("temporary error" fetching APKINDEX → missing ca-certificates/tzdata/wget).
FROM golang:1.26-bookworm AS build
WORKDIR /src
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/* \
  && update-ca-certificates
COPY go.mod go.sum ./
ENV GOPROXY=https://proxy.golang.org,direct
RUN go mod download
COPY . .
ARG SERVICE_PATH
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/service ./$SERVICE_PATH

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates tzdata wget \
  && rm -rf /var/lib/apt/lists/* \
  && update-ca-certificates \
  && groupadd --system --gid 10001 appuser \
  && useradd --system --uid 10001 --gid appuser --home-dir /app --shell /usr/sbin/nologin appuser
USER appuser
WORKDIR /app
COPY --from=build /out/service /app/service
EXPOSE 8080
ENTRYPOINT ["/app/service"]
